# =====================================================================
# Eventory 환경 변수 템플릿
# =====================================================================

# --- PortOne V2 (관리자 콘솔 https://admin.portone.io) ---
# 상점 아이디: 콘솔 우측 상단 또는 [결제 연동] > [연동 정보]  (예: store-xxxxxxxx-xxxx-...)
PORTONE_STORE_ID=
# 채널 키: [결제 연동] > [연동 정보] > [채널 관리] 에서 테스트 채널의 채널 키  (예: channel-key-xxxx...)
PORTONE_CHANNEL_KEY=
# V2 API Secret: [결제 연동] > [연동 정보] > [식별코드·API Keys] 의 "V2 API Secret"
# (V1 의 imp_key / imp_secret 과 다름 — 서버는 V2 REST API 를 사용한다)
PORTONE_V2_SECRET=
# 웹훅 시크릿 (선택): [결제 연동] > [웹훅] 에서 발급. 로컬에서는 웹훅을 받을 수 없어 비워도 된다
PORTONE_WEBHOOK_SECRET=

# --- QR 입장권 메일 발송 계정 (Gmail) ---

# 보내는 Gmail 주소
MAIL_USERNAME=

# Gmail 앱 비밀번호 16자리 (일반 로그인 비밀번호 아님)
# 발급: Google 계정 > 보안 > 2단계 인증 켜기 > 앱 비밀번호
# 화면에 "abcd efgh ijkl mnop" 처럼 보이면 공백을 빼고 붙여서 입력
MAIL_PASSWORD=

# 메일에 표시할 보내는 주소 (선택) — 비우면 MAIL_USERNAME 으로 발송
# Gmail 은 로그인 계정 주소로만 정상 발송되므로 보통 비워 두면 된다
MAIL_FROM=